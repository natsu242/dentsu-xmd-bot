{
    "version": 2,
    "outputDirectory": "public",
    "rewrites": [
      {
        "source": "/api/:path*",
        "destination": "https://dentsu-xmd-bot.onrender.com/api/:path*"
      }
    ],
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      }
    ]
  }